# Postgres (Compose uses these names; host is `postgres` in Docker or `localhost` locally)
POSTGRES_USER=penguwave
POSTGRES_PASSWORD=penguwave
POSTGRES_DB=penguwave

# Backend (matches docker-compose defaults when using local Postgres bound to localhost:5432)
# From host with Compose: Postgres is published as 5433 → 5432 in the DB container.
DATABASE_URL=postgresql://penguwave:penguwave@localhost:5433/penguwave
JWT_SECRET=dev-secret-change-in-production-min-32-bytes-recommended

PORT=3001
EVENTS_JSON_PATH=./data/mock_events.json

# Frontend: leave empty for Compose and for `npm run dev` (Vite proxies /api → localhost:3001). Set only if the API is on another origin.
# VITE_API_URL=http://localhost:3001
VITE_API_URL=
